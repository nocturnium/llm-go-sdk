# llm-go-sdk — example environment configuration
#
# Copy this file to `.env` and fill in only the providers you use:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. The SDK does not load
# `.env` automatically — use your shell, a process manager, or a loader such
# as github.com/joho/godotenv in your own application if you want .env support.
#
# Key resolution order (see ResolveAPIKey): explicit value passed in code >
# provider-specific variable below > the generic LLM_API_KEY fallback.

# --- Generic fallback -------------------------------------------------------
# Used by any provider when its specific key is unset.
LLM_API_KEY=

# --- Hosted providers (API keys) -------------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
FEATHERLESS_API_KEY=
SYNTHETIC_API_KEY=
ZAI_API_KEY=
RUNPOD_API_KEY=

# Google Gemini (either variable is accepted)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Perplexity (either variable is accepted)
PERPLEXITY_API_KEY=
PPLX_API_KEY=

# Azure OpenAI (key + endpoint required)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Self-hosted / local providers (base URLs) ------------------------------
# Defaults are used if unset; override to point at a remote instance.
OLLAMA_HOST=http://localhost:11434
LLAMA_CPP_HOST=http://localhost:8080

# Infinity (embeddings/reranking server)
INFINITY_API_KEY=
INFINITY_API_URL=

# --- Web search providers ---------------------------------------------------
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- Debugging --------------------------------------------------------------
# Set to "1"/"true" to log raw HTTP requests (never enable in production —
# request bodies may contain prompts and credentials).
LLM_DEBUG_REQUESTS=
